---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR } from '../../consts';
import { formatDate, getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const contents = headings.filter(({ depth }) => depth === 2);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  article
  published={post.data.pubDate}
  updated={post.data.updatedDate}
  noindex={post.data.draft}
>
  <article class="article container">
    <header class="article-header">
      <a class="back-link" href="/">&larr; All articles</a>
      {post.data.draft && <p class="draft-notice">Draft preview. This article is excluded from production builds.</p>}
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="post-meta">
        <span>{AUTHOR}</span>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && (
          <span>Updated <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></span>
        )}
      </div>
      {post.data.tags.length > 0 && (
        <ul class="tags" aria-label="Topics">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>
    {contents.length > 1 && (
      <nav class="table-of-contents" aria-label="On this page">
        <h2>On this page</h2>
        <ul>
          {contents.map(({ slug, text }) => <li><a href={`#${slug}`}>{text}</a></li>)}
        </ul>
      </nav>
    )}
    <div class="prose"><Content /></div>
    <footer class="article-footer">
      <a href="/">&larr; All articles</a>
      <a href="/rss.xml">Subscribe via RSS &rarr;</a>
    </footer>
  </article>
</BaseLayout>
